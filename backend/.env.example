# ── Server ─────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────
# MongoDB Database (Active)
DATABASE_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=susan-project

# MySQL Database (Backup - uncomment to switch)
# DATABASE_URI=mysql://user:pass@localhost:3306/db_name

# ── JWT ─────────────────────────
JWT_SECRET=change_this_to_a_strong_random_secret_key
JWT_EXPIRES_IN=7d

# ── File Uploads ─────────────────
MAX_FILE_SIZE_MB=5
UPLOADS_PATH=src/uploads

# ── AI Assistant (Groq) ──────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Email Notifications (Resend) ──
# Email notifications to students on complaint submission & status changes.
# When RESEND_API_KEY is unset, emails are skipped gracefully (no crash).
RESEND_API_KEY=re_your_resend_api_key_here
# Sender display name + address. Use your verified domain for production.
EMAIL_FROM="LASUSTECH Student Complaint Center" <onboarding@resend.dev>
# Public frontend URL used for the "Track your complaint" / reset links.
FRONTEND_URL=http://localhost:5173
# Redirect all emails to this address during testing (Resend free tier).
# Remove when a verified domain is configured.
EMAIL_REDIRECT_TO=
